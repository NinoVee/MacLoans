# Neon Postgres connection string (Dashboard → Connection Details → "Pooled connection")
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.us-east-2.aws.neon.tech/macloans?sslmode=require"

# Secret used to sign session cookies. Generate with: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string"

# Initial admin account created by `npm run db:seed`
SEED_ADMIN_EMAIL="admin@macnoenterprise.com"
SEED_ADMIN_PASSWORD="ChangeMe123!"
